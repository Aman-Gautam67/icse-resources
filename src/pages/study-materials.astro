---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClassNavigation from '../components/ClassNavigation.astro';
import ResourceLibrary from '../components/islands/ResourceLibrary';
import StudentSharedResources from '../components/islands/StudentSharedResources';
import { getStudyMaterialsSync, getSubjectSummary } from '../lib/data';
import { subjectSlug } from '../lib/resource-catalog.mjs';
import { collectLibraryFiles, getLibraryCategories, type LibrarySubject } from '../lib/resource-library';

const materials = getStudyMaterialsSync();
const subjects: LibrarySubject[] = getSubjectSummary(materials).map(subject => {
  const folder = materials.children?.find(child => child.type === 'folder' && child.name === subject.name);
  const categories = folder ? getLibraryCategories(folder) : [];
  return {
    name: subject.name,
    slug: subject.name === 'Featured books' ? 'featured' : (subject.path?.split('#')[1] || subjectSlug(subject.name)),
    description: subject.description,
    categories,
    count: categories.reduce((sum, category) => sum + category.count, 0),
  };
});
const featured = (materials.children || []).filter(child => child.type === 'file').flatMap(child => collectLibraryFiles(child));
if (featured.length) {
  const notesFiles = featured.filter(f => /pw endgame/i.test(f.name));
  const sampleFiles = featured.filter(f => !/pw endgame/i.test(f.name));
  const categories: LibraryCategory[] = [];
  if (notesFiles.length) categories.push({ name: 'Notes', files: notesFiles, count: notesFiles.length });
  if (sampleFiles.length) categories.push({ name: 'Sample papers and question banks', files: sampleFiles, count: sampleFiles.length });
  subjects.push({
    name: 'Featured books', slug: 'featured', description: 'Question banks and handbooks covering multiple Class 10 subjects.',
    categories, count: featured.length,
  });
}
// Small server-rendered previews; the complete existing data is fetched once in the browser.
function trimCategory(cat: LibraryCategory): LibraryCategory {
  return {
    ...cat,
    files: cat.files.slice(0, 5),
    subcategories: cat.subcategories ? cat.subcategories.slice(0, 3).map(sub => ({ ...sub, files: sub.files.slice(0, 3), subcategories: undefined })) : undefined,
  };
}
const previews = subjects.map(subject => ({ ...subject, categories: subject.categories.map(trimCategory) }));
---

<BaseLayout title="ICSE & ISC Study Materials, Revision Notes & Sample Papers" description="Find free ICSE Class 10 notes, textbook solutions and practice papers. Browse by subject or search the full resource library. ISC Class 12 resources are being added." currentPath="/study-materials">
  <div id="top" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-12">
    <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-5" aria-label="Breadcrumb"><a href="/" class="hover:text-foreground">Home</a><span aria-hidden="true">/</span><span class="text-foreground">Study Materials</span></nav>
    <ClassNavigation selectedClass={10} />
    <ResourceLibrary subjects={previews} client:load />
    <StudentSharedResources client:load />
    <noscript>
      <style>.resource-library { display: none; }</style>
      <section class="mt-8 space-y-3"><h1 class="text-2xl font-bold">Class 10 Study Materials</h1><p>ISC Class 12 resources are being added. Browse all Class 10 files using the link below, or enable JavaScript for search and compact previews.</p>
        <a class="inline-flex underline py-3" href="/study-materials/all">Browse all Class 10 resources</a>
      </section>
    </noscript>
  </div>
</BaseLayout>
