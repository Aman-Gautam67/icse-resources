---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/islands/ThemeToggle';
import { getAvailableClassesSync } from '../lib/data';
import { visibleClasses, boardForClass } from '../lib/class-options.mjs';
const classes = visibleClasses;
const available = getAvailableClassesSync();
---

<BaseLayout title="ICSE & ISC Resources — Choose your class" description="Choose your class to find study notes, textbook solutions and practice papers. Browse available resources for your class." currentPath="/" selectionOnly>
  <div class="class-entry">
    <header class="entry-header">
      <a class="entry-brand" href="/" aria-label="ICSE & ISC Resources home">
        <svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M3 5h7a4 4 0 0 1 4 4v15a4 4 0 0 0-4-4H3V5Zm22 0h-7a4 4 0 0 0-4 4v15a4 4 0 0 1 4-4h7V5Z" stroke="currentColor" stroke-width="1.5"/></svg>
        <span>ICSE & ISC<span class="brand-secondary">Resources</span></span>
      </a>
      <div class="entry-header-end"><span>THE STUDENT LIBRARY</span><ThemeToggle client:load /></div>
    </header>

    <section class="entry-content" aria-labelledby="class-title">
      <div class="entry-tabs" role="tablist" aria-label="Home views"><button id="browse-tab" type="button" role="tab" aria-selected="true" aria-controls="browse-panel">Browse classes</button><button id="share-tab" type="button" role="tab" aria-selected="false" aria-controls="share-panel">Share resources</button></div>
      <div id="browse-panel" role="tabpanel" aria-labelledby="browse-tab">
      <div class="entry-heading">
        <div><p class="entry-eyebrow"><span></span> A LITTLE DIRECTION. A LOT TO DISCOVER.</p><h1 id="class-title">Your class.<br /><span>Your starting point.</span></h1></div>
        <p class="entry-description">Choose your class to find the notes,<br class="desktop-break" /> guides, and practice papers you need for ICSE Class 10 and more.</p>
      </div>
      <nav class="entry-classes" aria-label="Choose your class">
        {classes.map(grade => <a href={`/study-materials?class=${grade}`} data-class-link={grade} class:list={['entry-class', { 'entry-class-ready': available.includes(String(grade)) }]}>
          <div class="entry-class-top"><span>{boardForClass(grade)} · CLASS</span><span class="entry-availability">{available.includes(String(grade)) ? 'Available now' : 'Coming soon'}</span></div>
          <span class="entry-number">{grade}</span>
          <div class="entry-class-bottom"><span>{available.includes(String(grade)) ? 'Explore resources' : 'Take a look ahead'}</span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5"/></svg></div>
        </a>)}
      </nav>
      <div class="entry-note"><span class="entry-note-line"></span><p>Explore an available class. More resources are added as the library grows.</p></div>
      </div>
      <div id="share-panel" role="tabpanel" aria-labelledby="share-tab" hidden>
        <div class="entry-heading"><div><p class="entry-eyebrow"><span></span> HELP THE STUDENT LIBRARY GROW.</p><h1>Share a<br /><span>resource.</span></h1></div><p class="entry-description">Send a paper, image, or PDF for review.<br />Only approved resources appear in the library.</p></div>
        <div class="share-layout">
          <form id="share-form" class="share-card">
            <div class="share-fields"><label>Discord ID <span>(optional)</span><input name="discord" maxlength="80" autocomplete="off" placeholder="Your Discord ID" /></label><label>Reddit ID <span>(optional)</span><input name="reddit" maxlength="80" autocomplete="off" placeholder="Your Reddit ID" /></label></div>
            <label class="share-opt-in"><input name="publicIdsOptIn" type="checkbox" /> Show my Discord and Reddit IDs in public Archive info.txt after approval</label>
            <p class="share-note">Unchecked IDs stay visible only to administrators. Internet Archive copies are public and may persist after removal from this site.</p>
            <fieldset><legend>Which class is this resource for?</legend><label><input type="radio" name="grade" value="10" required /> Class 10</label><label><input type="radio" name="grade" value="12" required /> Class 12</label></fieldset>
            <div class="share-fields"><label>Subject<input name="subject" type="text" maxlength="80" required placeholder="Type the subject name" /></label><label>What is this resource?<input name="resourceType" type="text" maxlength="120" required placeholder="Prelim paper, UT paper, notes…" /></label></div>
            <label>Upload image or PDF<input name="file" type="file" accept=".pdf,.jpg,.jpeg,.png,.gif,.webp,application/pdf,image/jpeg,image/png,image/gif,image/webp" required /></label>
            <p class="share-note">PDF, JPEG, PNG, GIF or WebP. Maximum 20 MB. Share only files you have permission to distribute.</p>
            <button id="share-submit" type="submit">Send for review <span aria-hidden="true">→</span></button><p id="share-message" role="status" aria-live="polite"></p>
          </form>
          <aside class="share-card share-status" aria-label="Review status"><p class="entry-eyebrow"><span></span> YOUR SUBMISSIONS</p><h2>Review status</h2><p>Track uploads saved in this browser. Keep your tracking code to check from another device.</p><div id="share-receipt" hidden><label for="receipt-code">Your tracking code</label><input id="receipt-code" readonly /><button id="copy-receipt" type="button">Copy code</button></div><ul id="share-status-list" aria-live="polite"></ul><form id="track-form"><label for="track-code">Have a tracking code?</label><input id="track-code" type="text" pattern="[a-f0-9]{64}" maxlength="64" autocomplete="off" placeholder="Paste code" required /><button type="submit">Check status</button></form><button id="refresh-status" type="button">Refresh status</button></aside>
        </div>
      </div>
    </section>

    <footer class="entry-footer"><span>Free to learn. Open to everyone.</span><span>CHOOSE A CLASS <span aria-hidden="true">→</span> FIND YOUR SUBJECT <span aria-hidden="true">→</span> START LEARNING</span></footer>
  </div>
</BaseLayout>

<script>
  const browseTab = document.getElementById('browse-tab') as HTMLButtonElement;
  const shareTab = document.getElementById('share-tab') as HTMLButtonElement;
  const browsePanel = document.getElementById('browse-panel') as HTMLElement;
  const sharePanel = document.getElementById('share-panel') as HTMLElement;
  function showTab(share: boolean) {
    browsePanel.hidden = share; sharePanel.hidden = !share;
    browseTab.setAttribute('aria-selected', String(!share)); shareTab.setAttribute('aria-selected', String(share));
    if (share) refreshStatus();
  }
  browseTab.addEventListener('click', () => showTab(false));
  shareTab.addEventListener('click', () => showTab(true));
  const storageKey = 'icse_submission_receipts_v1';
  const validReceipt = (value: unknown): value is string => typeof value === 'string' && /^[a-f0-9]{64}$/.test(value);
  function savedReceipts(): string[] {
    try { const value = JSON.parse(localStorage.getItem(storageKey) || '[]'); return Array.isArray(value) ? value.filter(validReceipt).slice(-30) : []; } catch { return []; }
  }
  function saveReceipt(receipt: string) {
    try { localStorage.setItem(storageKey, JSON.stringify([...new Set([...savedReceipts(), receipt])].slice(-30))); } catch {}
  }
  const shareMessage = document.getElementById('share-message') as HTMLElement;
  async function refreshStatus() {
    const receipts = savedReceipts();
    const list = document.getElementById('share-status-list') as HTMLUListElement;
    if (!receipts.length) { list.replaceChildren(); const item = document.createElement('li'); item.textContent = 'No submissions tracked yet.'; list.append(item); return; }
    try {
      const response = await fetch('/api/submissions/status', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ receipts }) });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Status unavailable.');
      if (!data.submissions.length) { list.textContent = 'No matching submissions. Check your tracking code.'; return; }
      list.replaceChildren(...data.submissions.map((item: { fileName: string; grade: number; status: string; rejectionReason: string; id: string }) => {
        const row = document.createElement('li'); const title = document.createElement('strong'); title.textContent = item.fileName;
        const detail = document.createElement('span'); detail.textContent = `Class ${item.grade} · ${item.status}${item.rejectionReason ? ` · ${item.rejectionReason}` : ''}`;
        row.append(title, detail);
        if (item.status === 'approved') { const link = document.createElement('a'); link.href = `/api/submissions/file?id=${encodeURIComponent(item.id)}`; link.textContent = 'Download'; row.append(link); }
        return row;
      }));
    } catch (error) { list.textContent = error instanceof Error ? error.message : 'Status unavailable.'; }
  }
  (document.getElementById('share-form') as HTMLFormElement).addEventListener('submit', async event => {
    event.preventDefault(); const form = event.currentTarget as HTMLFormElement; const button = document.getElementById('share-submit') as HTMLButtonElement;
    const file = (form.elements.namedItem('file') as HTMLInputElement).files?.[0];
    if (!file || file.size < 1 || file.size > 20 * 1024 * 1024) { shareMessage.textContent = 'Choose a non-empty file under 20 MB.'; return; }
    button.disabled = true; shareMessage.textContent = 'Uploading…';
    try {
      const response = await fetch('/api/submissions', { method: 'POST', body: new FormData(form) });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Upload failed.');
      saveReceipt(data.receipt); form.reset(); shareMessage.textContent = 'Upload received. Review is pending.';
      (document.getElementById('receipt-code') as HTMLInputElement).value = data.receipt;
      (document.getElementById('share-receipt') as HTMLElement).hidden = false;
      refreshStatus();
    } catch (error) { shareMessage.textContent = error instanceof Error ? error.message : 'Upload failed.'; }
    finally { button.disabled = false; }
  });
  (document.getElementById('track-form') as HTMLFormElement).addEventListener('submit', event => {
    event.preventDefault(); const input = document.getElementById('track-code') as HTMLInputElement; const receipt = input.value.trim().toLowerCase();
    if (!validReceipt(receipt)) return; saveReceipt(receipt); input.value = ''; refreshStatus();
  });
  document.getElementById('refresh-status')?.addEventListener('click', refreshStatus);
  document.getElementById('copy-receipt')?.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText((document.getElementById('receipt-code') as HTMLInputElement).value); shareMessage.textContent = 'Tracking code copied.'; } catch { shareMessage.textContent = 'Select and copy the code above.'; }
  });
  if (location.hash === '#share') showTab(true);
</script>

<style>
  .entry-tabs { display:flex; gap:.45rem; align-self:flex-start; border-bottom:1px solid hsl(var(--border)); margin-bottom:2rem; }
  .entry-tabs button { padding:.65rem 1rem; font-size:.76rem; font-weight:600; color:hsl(var(--muted-foreground)); border-bottom:2px solid transparent; }
  .entry-tabs button[aria-selected="true"] { color:hsl(var(--foreground)); border-color:hsl(var(--primary)); }
  .entry-tabs button:focus-visible,.share-card button:focus-visible,.share-card input:focus-visible { outline:2px solid hsl(var(--primary)); outline-offset:3px; }
  .share-layout { display:grid; grid-template-columns:minmax(0,1.7fr) minmax(240px,1fr); gap:1rem; }
  .share-card { border:1px solid hsl(var(--border)); background:hsl(var(--card) / .75); border-radius:7px; padding:1.35rem; }
  .share-fields { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
  .share-card label,.share-card legend { display:block; font-size:.73rem; font-weight:600; color:hsl(var(--foreground)); margin:.7rem 0 .35rem; }
  .share-card label span,.share-note { color:hsl(var(--muted-foreground)); font-weight:400; }
  .share-card input:not([type="radio"]) { display:block; width:100%; margin-top:.45rem; padding:.7rem; border:1px solid hsl(var(--border)); border-radius:5px; background:hsl(var(--background)); color:hsl(var(--foreground)); font-size:.76rem; }
  .share-card fieldset { border:0; padding:.4rem 0; margin:0; }
  .share-card fieldset label { display:inline-flex; align-items:center; gap:.45rem; margin-right:1.3rem; }
  .share-card .share-opt-in { display:flex; align-items:flex-start; gap:.55rem; font-weight:400; line-height:1.5; }
  .share-card .share-opt-in input { flex:none; margin-top:.2rem; }
  .share-card button { border:1px solid hsl(var(--primary)); background:hsl(var(--primary)); color:hsl(var(--primary-foreground)); border-radius:5px; padding:.65rem .9rem; font-size:.72rem; font-weight:600; margin-top:.7rem; }
  .share-card button:disabled { opacity:.6; }
  .share-card p,.share-card li { font-size:.72rem; line-height:1.6; color:hsl(var(--muted-foreground)); }
  .share-card h2 { font-size:1.5rem; font-weight:600; }
  .share-card ul { list-style:none; padding:0; margin:1rem 0; }
  .share-card li { display:grid; gap:.2rem; border-top:1px solid hsl(var(--border)); padding:.65rem 0; overflow-wrap:anywhere; }
  .share-card li strong { color:hsl(var(--foreground)); font-weight:600; }
  .share-card li a { color:hsl(var(--primary)); text-decoration:underline; }
  .share-status { align-self:start; }
  #share-message { min-height:1.2rem; }
  @media (max-width:750px) { .share-layout { grid-template-columns:1fr; } }
  @media (max-width:480px) { .share-fields { grid-template-columns:1fr; gap:0; } }
  .class-entry { max-width: 1440px; min-height: 100svh; margin: 0 auto; padding: 0 clamp(1.25rem, 5vw, 5rem); display: flex; flex-direction: column; }
  .entry-header { height: 104px; flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-bottom: 1px solid hsl(var(--border) / .65); }
  .entry-brand { display: flex; align-items: center; gap: .8rem; font-weight: 700; font-size: 1rem; letter-spacing: -.035em; }
  .entry-brand > svg { width: 28px; height: 28px; }
  .brand-secondary { margin-left: .35rem; font-weight: 400; }
  .entry-header-end { display: flex; gap: 1.7rem; align-items: center; }
  .entry-header-end > span { font-size: .6rem; letter-spacing: .16em; color: hsl(var(--muted-foreground)); }
  .entry-content { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 4rem 0; }
  .entry-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 3rem; }
  .entry-eyebrow { display: flex; align-items: center; gap: .65rem; font-size: .6rem; font-weight: 600; letter-spacing: .14em; margin-bottom: 1.55rem; color: hsl(var(--muted-foreground)); }
  .entry-eyebrow > span { width: 5px; height: 5px; background: hsl(var(--foreground)); }
  h1 { font-family: 'Trebuchet MS', 'Segoe UI', sans-serif; font-size: clamp(2.6rem, 5.6vw, 5.1rem); font-weight: 600; letter-spacing: -.065em; line-height: 1.06; }
  h1 > span { color: hsl(var(--primary)); }
  .entry-description { padding-bottom: .35rem; font-size: .85rem; line-height: 1.8; color: hsl(var(--muted-foreground)); }
  .entry-classes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .entry-class { --entry-surface: 270 50% 94%; --entry-ink: 270 40% 28%; min-height: 264px; display: flex; flex-direction: column; justify-content: space-between; padding: 1.35rem; color: hsl(var(--entry-ink)); background: hsl(var(--entry-surface)); border: 1px solid hsl(var(--entry-ink) / .18); border-radius: 7px; transition: border-color 300ms ease, transform 300ms ease; }
  .entry-class:nth-child(2) { --entry-surface: 207 65% 94%; --entry-ink: 211 50% 29%; }
  .entry-class:nth-child(4) { --entry-surface: 154 42% 93%; --entry-ink: 158 45% 26%; }
  .entry-class:hover { border-color: hsl(var(--entry-ink) / .65); transform: translateY(-4px); }
  .entry-class-top { display: flex; align-items: center; justify-content: space-between; gap: .5rem; font-size: .6rem; letter-spacing: .14em; }
  .entry-availability { font-size: .61rem; letter-spacing: 0; color: hsl(var(--entry-ink) / .85); }
  .entry-number { font-family: 'Trebuchet MS', 'Segoe UI', sans-serif; font-size: clamp(4rem, 7vw, 6.5rem); line-height: 1; letter-spacing: -.085em; font-weight: 400; margin: 1.45rem 0 1.55rem; }
  .entry-class-bottom { display: flex; align-items: center; justify-content: space-between; gap: .5rem; font-size: .72rem; padding-top: 1rem; border-top: 1px solid hsl(var(--foreground) / .12); }
  .entry-class-bottom svg { width: 19px; height: 19px; transition: transform 300ms ease; }
  .entry-class:hover .entry-class-bottom svg { transform: translateX(3px); }
  .entry-class-ready, .entry-class-ready:hover { --entry-ink: 35 100% 97%; background: hsl(16 64% 40%); color: hsl(var(--entry-ink)); border-color: hsl(16 64% 40%); }
  .entry-class-ready .entry-class-bottom { border-color: hsl(var(--entry-ink) / .25); }
  :global(.dark) .entry-class { --entry-surface: 268 22% 18%; --entry-ink: 270 45% 84%; }
  :global(.dark) .entry-class:nth-child(2) { --entry-surface: 211 27% 18%; --entry-ink: 208 46% 82%; }
  :global(.dark) .entry-class:nth-child(4) { --entry-surface: 157 22% 16%; --entry-ink: 151 35% 78%; }
  :global(.dark) .entry-class-ready { --entry-ink: 35 60% 91%; background: hsl(20 37% 28%); border-color: hsl(23 42% 45%); }
  .entry-note { display: flex; align-items: center; gap: .7rem; margin-top: 1.25rem; font-size: .7rem; color: hsl(var(--muted-foreground)); }
  .entry-note-line { width: 20px; height: 1px; background: hsl(var(--muted-foreground)); flex-shrink: 0; }
  .entry-footer { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 80px; border-top: 1px solid hsl(var(--border) / .65); color: hsl(var(--muted-foreground)); font-size: .68rem; }
  .entry-footer > span:last-child { font-size: .52rem; letter-spacing: .1em; }
  .entry-footer > span:last-child > span { margin: 0 .55rem; }
  .class-entry a:focus-visible { outline: 2px solid hsl(var(--foreground)); outline-offset: 5px; }
  @media (max-width: 850px) {
    .entry-header { height: 80px; }
    .entry-heading { align-items: start; flex-direction: column; gap: 1.1rem; margin-bottom: 2rem; }
    .entry-classes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .entry-class { min-height: 205px; }
    .entry-number { font-size: 4.4rem; margin: .8rem 0 1rem; }
    .desktop-break { display: none; }
    .entry-content { padding: 2.5rem 0; }
    .entry-footer > span:last-child { display: none; }
  }
  @media (max-width: 480px) {
    .entry-header { height: 72px; }
    .entry-header-end > span { display: none; }
    .entry-eyebrow { font-size: .5rem; letter-spacing: .1em; margin-bottom: 1.1rem; }
    .entry-heading { gap: 1rem; margin-bottom: 1.65rem; }
    h1 { font-size: 2.65rem; }
    .entry-description { font-size: .78rem; }
    .entry-classes { gap: .7rem; }
    .entry-class { min-height: 183px; padding: .95rem; }
    .entry-class-top { font-size: .52rem; letter-spacing: .08em; }
    .entry-availability { font-size: .53rem; }
    .entry-number { font-size: 3.8rem; }
    .entry-class-bottom { font-size: .62rem; padding-top: .7rem; }
    .entry-class-bottom svg { width: 16px; height: 16px; }
    .entry-note { font-size: .63rem; align-items: baseline; line-height: 1.7; }
    .entry-footer { min-height: 60px; }
  }
  @media (prefers-reduced-motion: reduce) { .class-entry * { transition: none !important; } }
</style>
